TIFA_ASSISTANT_ENABLED=1
TIFA_TIMEZONE=Asia/Ho_Chi_Minh
TIFA_RUNTIME_DIR=runtime
TIFA_PROMPT_PATH=prompts/TIFA_NEXUS_CRYPTO_RUNTIME.md

TIFA_LLM_PROVIDER=gemini
TIFA_LLM_ROUTING_POLICY=cost-aware
TIFA_LLM_FALLBACK_ORDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
